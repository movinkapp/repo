# Movink — exemplo de variáveis de ambiente
# Copie para .env e preencha com os valores reais. Nunca commite o .env.

# ─── Cliente (expostas no bundle do browser) ───────────────────────────
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=
PUBLIC_SENTRY_DSN=
VITE_VAPID_PUBLIC_KEY=

# ─── Servidor (privadas — nunca expor no client) ───────────────────────
SENTRY_DSN=
FUNCTION_SECRET=
RESEND_API_KEY=

# ─── Supabase Edge Functions (configuradas no painel Supabase) ─────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:
